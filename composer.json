{
    "name": "meetaj/portfolio-cms",
    "type": "project",
    "description": "Meet AJ portfolio and article CMS preserving the original static design",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "symfony/html-sanitizer": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "mockery/mockery": "^1.6"
    },
    "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
        "test": "@php vendor/phpunit/phpunit/phpunit"
    },
    "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "platform": {"php": "8.4.0"}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
