{
  "id": null,
  "uid": "enterprise-linux",
  "title": "Linux Server Monitoring",
  "description": "Authored importable dashboard; select existing discovered items. No simulated metric values.",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "tags": [
    "Grafana",
    "Zabbix",
    "Linux"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "group",
        "label": "Group",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "zabbix-enterprise"
        },
        "query": {
          "queryType": "group",
          "group": "/Linux servers/"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {},
        "options": []
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "zabbix-enterprise"
        },
        "query": {
          "queryType": "host",
          "group": "$group",
          "host": "/.*/"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {},
        "options": []
      },
      {
        "name": "item_group",
        "label": "Item Group",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "zabbix-enterprise"
        },
        "query": {
          "queryType": "itemTag",
          "group": "$group",
          "host": "$host",
          "itemTag": "/component:.*/"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "/.*/",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          }
        ]
      },
      {
        "name": "interface",
        "label": "Interface",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "zabbix-enterprise"
        },
        "query": {
          "queryType": "item",
          "group": "$group",
          "host": "$host",
          "item": "/Interface .*: Bits received/"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "/Interface .*: Bits received/",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          }
        ]
      }
    ]
  },
